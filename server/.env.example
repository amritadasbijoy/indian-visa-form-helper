# Copy to /opt/ivh/.env on the VPS (chmod 600). Never commit the real file.
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8099
# The VPS's Tailscale IP: the admin dashboard is only reachable over Tailscale.
ADMIN_HOST=100.x.y.z
ADMIN_PORT=8100
ADMIN_PASSWORD=change-me
DATA_DIR=/opt/ivh/data
CHECK_HOURS=12
# Optional alerts when the visa site changes:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
